# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.

# GitHub personal access token with read:packages, used only while building the image
# to restore the DiceRoller.BuildingBlocks packages from GitHub Packages.
NUGET_AUTH_TOKEN=

# SQL Server 'sa' password: at least 8 characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=

# JWT settings. Every DiceRoller service that validates these tokens must use the same values.
JWT_ISSUER=diceroller
JWT_AUDIENCE=diceroller
# At least 32 bytes, e.g. the output of: openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_EXPIRY_MINUTES=60

# Host port the service is published on (the .http file uses 5080).
USERACCESS_PORT=5080
